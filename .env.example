# LoopRAG configuration — copy to .env and fill in if you want online mode.
# Never commit .env. The CLI only reads LOOPRAG_* keys from this file and
# never overrides variables that are already set in your environment.

# API key for an OpenAI-compatible chat endpoint.
# LOOPRAG_API_KEY=your-key-here

# Optional base URL for OpenAI-compatible providers (OpenAI default when unset).
# LOOPRAG_BASE_URL=https://api.openai.com/v1

# Chat model name (default: gpt-4o-mini).
# LOOPRAG_MODEL=gpt-4o-mini
